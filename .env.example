# HOWTOM 콘텐츠 제작소 — 환경변수 예시
# 실제 값은 절대 이 파일이나 Git에 커밋하지 않습니다. Railway Variables에만 설정합니다.

# --- 공통 (Universe와 반드시 같은 값이어야 함) ---
DATABASE_URL=
JWT_SECRET=
HOWTOM_ADMIN_EMAIL=
HOWTOM_ADMIN_PASSWORD=
HOWTOM_ADMIN_NAME=관리자

# --- 앱 전환 ---
# Content Studio 상단 "HOWTOM ▾"에서 돌아갈 Universe 실제 URL
VITE_UNIVERSE_URL=

# --- 레퍼런스 커넥터 ---
# Meta 광고 라이브러리 (신원 확인을 마친 계정 토큰 필요, ads_read 토큰과는 별개)
META_AD_LIBRARY_ACCESS_TOKEN=
# Instagram 해시태그 검색 (instagram_basic 권한 필요)
META_ACCESS_TOKEN=
# YouTube 검색 (Google Cloud Console에서 YouTube Data API v3 발급)
YOUTUBE_API_KEY=

# --- 공용 AI Gateway (레퍼런스 AI 분석 등에서 사용) ---
# provider: anthropic | openai | custom
AI_PROVIDER=
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# --- 블로그 AI 원고 생성 (오토포스트 Pro - ㈜시온랩스 제휴 API) ---
# 이게 설정되어 있으면 이걸 우선 사용합니다. 병원·세무·학원·동물병원 4개 업종만
# 기본 지원하며, 광고주의 business_reg_no(사업자등록번호)가 반드시 있어야 합니다.
AUTOPOST_PRO_API_KEY=
AUTOPOST_PRO_BASE_URL=https://aiblog.zionlabs.org

# --- 블로그 AI 원고 생성 (범용 자리 - 오토포스트 Pro 외 다른 업체용) ---
# AUTOPOST_PRO_API_KEY가 없을 때만 이 값을 씁니다. 확정된 업체가 없으면 비워둡니다.
BLOG_PARTNER_API_URL=
BLOG_PARTNER_API_KEY=

# Railway가 자동 주입하므로 일반적으로 직접 지정하지 않습니다.
PORT=
